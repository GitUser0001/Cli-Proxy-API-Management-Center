[Unit]
Description=Private CLIProxyAPI device usage collector
After=network-online.target cliproxyapi.service
RequiresMountsFor=/work/cliproxyapi-usage

[Service]
User=cliproxyapi-usage
Group=cliproxyapi-usage
ExecStart=/usr/bin/python3 /opt/cliproxyapi/current/support/device-usage.py
LoadCredential=management-key:/etc/ai-devbox-secrets/cliproxyapi-management-key
Environment=USAGE_STATE=/work/cliproxyapi-usage
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/work/cliproxyapi-usage
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
